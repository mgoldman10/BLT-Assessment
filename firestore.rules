rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    // COMPANIES COLLECTION
    // - Admins: full access
    // - Public: read access + add responses (for participants)
    match /companies/{companyId} {
      // Allow admins full access
      allow read, write, delete: if isAdmin();

      // Allow public read (for participants viewing assessment)
      allow read: if true;

      // Allow public to add responses (participants submitting)
      allow update: if !isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses', 'lastActivity']) &&
                       request.resource.data.responses.size() == resource.data.responses.size() + 1;
    }

    // TEMPLATES COLLECTION
    // - Public read (participants need to see questions)
    // - Only admins can write/delete
    match /templates/{templateId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // USERS COLLECTION
    // - Authenticated users can read their own document
    // - Admins can read all users
    // - Super admins can create/update/delete users
    // - New users can create their own initial document (for user creation flow)
    match /users/{userId} {
      // Allow users to read their own document (needed for login)
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Allow admins to read all users
      allow read: if isAdmin();

      // Allow super admins to write/delete any user
      allow write: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // CRITICAL: Allow newly created users to write their own initial document
      // This enables the user creation flow where admin creates Firebase Auth user
      // and then the new user creates their Firestore metadata
      allow create: if isAuthenticated() &&
                       request.auth.uid == userId &&
                       !exists(/databases/$(database)/documents/users/$(userId));
    }

    // SETTINGS COLLECTION
    // - Only admins can read settings
    // - Only super admins can update settings
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
